# Porta de entrada do sistema.
#
# ENDERECO vale ":80" numa instalação local (HTTP puro) ou o domínio da loja
# ("loja.exemplo.com.br"). Com um domínio de verdade, o Caddy pede e renova o certificado
# do Let's Encrypt sozinho — é por isso que ele está aqui em vez do Nginx.
{$ENDERECO} {
	encode gzip

	# Cabeçalhos de navegador que a API não põe — eles são do PROXY, que é quem fala com o
	# navegador (a API já manda X-Content-Type-Options, X-Frame-Options e Referrer-Policy).
	#
	# CSP: o access token mora em memória, e um XSS o levaria. Esta é a segunda barreira,
	# depois do escape do `html` de ui.js. O SPA não carrega nada de fora: um script só
	# (js/main.js, módulo), CSS e imagens da própria loja, a foto da peça como blob: antes
	# de subir, o ícone em data: e o WebSocket do tempo real na mesma origem. `'self'` já
	# casa ws/wss da mesma origem nos navegadores atuais; o {hostport} explícito cobre os
	# antigos. Estilo inline existe (style="" nas telas e no recibo impresso), por isso
	# 'unsafe-inline' SÓ em style-src. Script inline não: nenhum atributo onclick="".
	#
	# HSTS: só vale quando a resposta vem por HTTPS (o navegador ignora em HTTP), então pode
	# ir sempre. Sem includeSubDomains: o domínio da loja pode ser subdomínio de um site
	# que ainda tem coisa em HTTP.
	#
	# /docs e /redoc ficam de fora da CSP: o Swagger vem de CDN, e só existe fora de
	# produção (ambiente local), onde quebrá-lo não protegeria nada.
	@app not path /docs* /redoc*
	header @app {
		defer
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ws://{hostport} wss://{hostport}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}
	header {
		defer
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		# O Caddy anuncia o próprio nome em toda resposta; não precisa.
		-Server
	}

	# A DEMONSTRAÇÃO (ADR-46) mora em /demo: outra API (api-demo), com banco, segredo do login
	# e fotos próprios — a loja de verdade nunca atende nada daqui. O prefixo NÃO é tirado: a
	# api-demo se monta sob /demo e gera os próprios caminhos com ele (o cookie da sessão com
	# Path=/demo/..., o redirecionamento para /demo/app/). É isso que impede o navegador de
	# misturar a sessão de uma com a da outra, que aqui dividem a mesma origem.
	redir /demo /demo/ 308
	handle /demo/* {
		reverse_proxy api-demo:8000
	}

	# O sistema web e a API são a mesma origem: a página em /app e os dados em /api/v1.
	handle {
		reverse_proxy api:8000
	}

	# A demo desligada (sem o profile) ou ainda semeando: resposta clara em vez de um 502
	# vazio — e NUNCA a loja real no lugar. Só chega aqui erro do próprio Caddy (não alcançou a
	# api-demo); um 404 da api-demo é resposta normal e passa direto. Sem matcher que case
	# (a loja real fora do ar), o Caddy responde como sempre respondeu: o código, sem corpo.
	handle_errors {
		@demo_api path /demo/api/*
		handle @demo_api {
			header Content-Type "application/json; charset=utf-8"
			respond "{\"code\":\"DEMONSTRACAO_FORA_DO_AR\",\"message\":\"A demonstração está desligada ou começando. Tente de novo em um minuto.\",\"detail\":{}}" 503
		}
		@demo path /demo /demo/*
		handle @demo {
			header Content-Type "text/plain; charset=utf-8"
			respond "A demonstração está desligada ou começando. Tente de novo em um minuto." 503
		}
	}

	log {
		output stdout
		format console
	}
}
