{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true
    },
    "teste-aparelhos": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "language": "pt-BR",
        "sku": "gestao-loja"
      }
    },
    "ci": {
      "extends": "production",
      "ios": {
        "language": "pt-BR",
        "sku": "gestao-loja",
        "ascApiKeyPath": "$ASC_API_KEY_PATH",
        "ascApiKeyId": "$ASC_KEY_ID",
        "ascApiKeyIssuerId": "$ASC_ISSUER_ID"
      }
    }
  }
}
