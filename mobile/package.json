{
  "name": "gestao-loja-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/*.test.ts",
    "bundle": "expo export --platform android --output-dir .expo-export",
    "web": "expo start --web",
    "web:build": "expo export --platform web --output-dir dist-web",
    "web:servir": "node servir-web.mjs dist-web 8090",
    "publicar": "node publicar/publicar.mjs",
    "publicar:simular": "node publicar/publicar.mjs --simular",
    "publicar:build": "node publicar/enviar-build.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-community/netinfo": "11.4.1",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.19.0",
    "date-fns": "^4.4.0",
    "expo": "~54.0.37",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.14",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.86.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "~19.1.10",
    "tsx": "^4.20.7",
    "typescript": "~5.9.2"
  },
  "private": true
}
