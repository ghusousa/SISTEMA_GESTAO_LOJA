{
  "expo": {
    "name": "Gestão de Loja",
    "slug": "gestao-loja",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "gestaoloja",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gestaoloja.app",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "O aplicativo se conecta ao servidor da sua loja para consultar o estoque e registrar as vendas.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.gestaoloja.app",
      "adaptiveIcon": {
        "backgroundColor": "#1E3A5F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "O aplicativo usa a proteção do aparelho para guardar sua sessão com segurança."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O aplicativo usa a câmera para ler o código de barras das peças na venda e no cadastro.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O aplicativo acessa suas fotos para você escolher a imagem da peça.",
          "cameraPermission": "O aplicativo usa a câmera para você fotografar a peça no cadastro.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1E3A5F"
        }
      ]
    ]
  }
}
