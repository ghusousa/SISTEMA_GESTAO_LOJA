# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Ambiente e segredos — nunca versionar
.env
.env.*
!.env.example

# Uploads em disco
api/media/

# Cópia do web/ que o build da Vercel faz dentro do Root Directory (ADR-42). Gerada,
# nunca editada: a fonte é o web/ da raiz.
api/web_vercel/
.vercel/

# Grafo do código (graphify): ~7 MB, reescrito inteiro a cada build e refeito em ~10 s pelo
# .claude/hooks/session-start.sh. No git, cada commit carregaria um diff de megabytes.
graphify-out/

# Node / Expo
node_modules/
.expo/
dist/
web-build/
*.tsbuildinfo

# Sistema operacional / editores
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# Bundle de verificação local do Expo
mobile/.expo-export/

# Certificado de rede corporativa: local, nunca versionado
docker/certificados/*.crt

# Backups e logs guardados pelo desinstalador e pelo ./atualizar.sh.
# O padrão é `loja-backup-*` sem extensão de propósito: um arquivo gerado aqui que
# escape do .gitignore vira "alteração local" e faz o PRÓXIMO ./atualizar.sh se recusar
# a rodar — com a loja esperando.
loja-backup-*

# Coletas do ./diagnostico.sh — ficam na pasta do servidor, nunca no repositório.
# (Sem isto, o arquivo vira "alteração local" e o PRÓXIMO ./atualizar.sh se recusa a rodar.)
diagnostico-*.txt

# Estado escrito pelo ./atualizar.sh e lido pela API (que versão está instalada, se é a
# mais nova). É de cada servidor, nunca do repositório — a pasta fica, o conteúdo não.
docker/estado/*
!docker/estado/.gitkeep

# Cópias de segurança do ./backup.sh — de cada servidor, nunca do repositório.
backups/
