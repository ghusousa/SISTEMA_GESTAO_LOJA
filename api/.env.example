# Copie para .env e ajuste. NUNCA versione o .env real.
AMBIENTE=dev
DEBUG=true

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/loja
DB_ECHO=false

# Em produção: gere com  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-esta-chave-em-producao
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Em produção, liste as origens reais separadas por vírgula.
CORS_ORIGINS=*

TIMEZONE_LOJA=America/Sao_Paulo
MEDIA_DIR=media
