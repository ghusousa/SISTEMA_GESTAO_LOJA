# Copie para .env e ajuste. NUNCA versione o .env real.
AMBIENTE=dev
DEBUG=true

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/loja
DB_ECHO=false

# Em produção: gere com  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-esta-chave-em-producao
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Em produção, liste as origens reais separadas por vírgula.
CORS_ORIGINS=*

TIMEZONE_LOJA=America/Sao_Paulo
MEDIA_DIR=media
# Fotos no Vercel Blob (ADR-42), só na demonstração da Vercel: com o token, a foto vai para
# um Blob store PÚBLICO e o MEDIA_DIR deixa de ser usado. Na loja, deixe sem.
# BLOB_READ_WRITE_TOKEN=

# NFC-e (ADR-41). Desligado até o dono contratar um emissor e cadastrar nele o
# certificado A1 e o CSC. Teste SEMPRE em homologação antes de producao.
# O token assina nota no CNPJ da loja: só aqui, nunca no banco nem em tela.
FISCAL_EMISSOR=desligado
# FISCAL_EMISSOR=focusnfe
# FOCUSNFE_TOKEN=
# FOCUSNFE_AMBIENTE=homologacao
# FISCAL_EMITIR_AUTOMATICO=0
