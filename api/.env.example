# Copie para .env e ajuste. NUNCA versione o .env real.
AMBIENTE=dev
DEBUG=true

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/loja
DB_ECHO=false
# Conexões abertas por processo (padrão 10 + 20). Na Vercel o padrão é 2 + 3, e a URL do Neon
# (postgres://...?sslmode=require, DATABASE_URL_UNPOOLED) é traduzida sozinha (ADR-42).
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# Em produção: gere com  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-esta-chave-em-producao
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Em produção, liste as origens reais separadas por vírgula.
CORS_ORIGINS=*

TIMEZONE_LOJA=America/Sao_Paulo
MEDIA_DIR=media
# Fotos no Vercel Blob (ADR-42), só na demonstração da Vercel: com o token, a foto vai para
# um Blob store PÚBLICO e o MEDIA_DIR deixa de ser usado. Na loja, deixe sem.
# BLOB_READ_WRITE_TOKEN=

# NFC-e (ADR-41). Desligado até o dono contratar um emissor e cadastrar nele o
# certificado A1 e o CSC. Teste SEMPRE em homologação antes de producao.
# O token assina nota no CNPJ da loja: só aqui, nunca no banco nem em tela.
FISCAL_EMISSOR=desligado
# FISCAL_EMISSOR=focusnfe
# FOCUSNFE_TOKEN=
# FOCUSNFE_AMBIENTE=homologacao
# FISCAL_EMITIR_AUTOMATICO=0

# Push do chamado do leitor (ADR-47): "desligado" (padrão) ou "expo". Sem segredo: o push sai
# pela API da Expo com a credencial de quem publica o app. Ligue só depois de a chave APNs
# estar na Expo e o teste no TestFlight passar. Desligado, o chamado chega ao app ABERTO e o
# QR continua; o app nem pede a permissão de notificação. Na demo da instalação a variável é
# DEMO_NOTIFICACOES_PUSH (no .env da raiz). A notificação não chega? `python -m app.cli
# testar-push --email <login>` manda um aviso de teste aos celulares do login e diz o que a
# Apple respondeu (a chave APNs que falta só aparece aí); o motivo de cada recusa também vai
# para o log da API, só com o código do erro.
NOTIFICACOES_PUSH=desligado
